# =================================================================
# Open Source Companion - Environment Variables
# =================================================================
# Note: Copy this file to .env or .env.local and populate with your values.
# Never commit real credentials to version control.

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=opensource_companion

# Database Connection String
# Inside Docker Compose network (uses service name 'postgres'):
DATABASE_URL="postgresql://postgres:your_secure_postgres_password@postgres:5432/opensource_companion?schema=public"
# For local host execution outside Docker (optional):
# DATABASE_URL="postgresql://postgres:your_secure_postgres_password@localhost:5432/opensource_companion?schema=public"

# Auth.js / NextAuth Session Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_minimum_32_characters

# GitHub OAuth App Credentials
# Create at: https://github.com/settings/developers
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret

# Legacy Auth.js aliases (optional fallback)
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret

# Application Canonical URL
# Local Docker: http://localhost:3000
# Production: https://your-domain.com
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Trust host header behind reverse proxies / containers
AUTH_TRUST_HOST=true

# Optional: GitHub Personal Access Token (PAT)
# Increases rate limit from 60 to 5,000 req/hr for exploring GitHub issues
GITHUB_TOKEN=
