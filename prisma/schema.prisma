datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  contributions Contribution[]
  achievements  Achievement[]
  
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_token")
}

model UserProfile {
  userId          String   @id
  points          Int      @default(0)
  streak          Int      @default(0)
  github_username String?
  location        String?
  bio             String?
  experienceLevel String   @default("Beginner")
  languages       String[]
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Issue {
  id              String   @id
  title           String
  repository      String
  description     String
  difficulty      String
  estimatedEffort String
  languages       String[]
  technologies    String[]
  
  contributions Contribution[]

  @@map("issues")
}

model Contribution {
  id        String   @id @default(cuid())
  userId    String
  issueId   String
  status    String   // 'enrolled', 'pr_submitted', 'merged'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("contributions")
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String   @map("badge_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("achievements")
}
